[Unit]
Description=CareerVine send watcher (CAR-215) - triggers due-send sweeps within seconds
Documentation=https://linear.app/career-vine/issue/CAR-215
After=network-online.target
Wants=network-online.target

# A watcher that stays down is the failure this whole design guards against, so
# never let systemd give up on it: 0 disables the start rate limiter that would
# otherwise leave it dead after repeated fast failures (a Supabase outage at
# boot, say). This key belongs in [Unit], not [Service] — systemd 249 parses it
# nowhere else and logs "Unknown key name ... ignoring", which is silent enough
# to look like it worked.
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# Holds WATCHER_DB_DSN, CRON_TRIGGER_SECRET, APP_BASE_URL, HEARTBEAT_URL.
# chmod 600, root-owned; never in git.
EnvironmentFile=/etc/careervine/send-watcher.env
ExecStart=/usr/bin/python3 /opt/careervine/send-watcher/send_watcher.py
# Unbuffered so journalctl shows a cycle as it happens, not on flush.
Environment=PYTHONUNBUFFERED=1

Restart=always
RestartSec=10

# It needs outbound network and nothing else on this box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, not true: libpq looks for an optional client cert at
# ~/.postgresql/postgresql.crt on every connect. Under ProtectHome=true that
# path is masked and the probe fails EACCES, which libpq treats as fatal — the
# daemon could not open a single database connection. The file does not exist,
# so a readable /home returns ENOENT instead, which libpq correctly ignores.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
